# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/frauddb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SMTP fraud alert email settings (use an app password, never your real password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Comma-separated list of fraud analyst recipient addresses
FRAUD_ALERT_EMAIL=fraud-analyst@yourdomain.com
